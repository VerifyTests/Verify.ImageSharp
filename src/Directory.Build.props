<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NoWarn>CS1591;CS0649;NU1608;NU1109</NoWarn>
    <Version>5.0.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
